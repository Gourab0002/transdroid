<?xml version="1.0" encoding="utf-8"?>
<!-- Transdroid launcher glyph: a bold rounded download arrow into a tray, ringed like a
     radar sweep to suggest remote control of your daemons. Kept in the 72dp safe zone
     and single-hue so the monochrome (themed-icon) variant reads cleanly. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Signal ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.38"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M28,55 a26,26 0 1,0 52,0 a26,26 0 1,0 -52,0" />
    <!-- Arrow shaft -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:pathData="M54,34 L54,61" />
    <!-- Arrow head -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M39,51 L54,66 L69,51" />
    <!-- Tray -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M37,80 L71,80" />
</vector>
